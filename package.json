{
  "name": "vite-plus-commitlint",
  "version": "1.1.3",
  "description": "Unified Commitlint plugin and CLI for Vite+",
  "keywords": [
    "commitlint",
    "conventional-commits",
    "git-hooks",
    "rust",
    "vite",
    "vite-plus"
  ],
  "license": "MIT",
  "bin": {
    "commitlint": "dist/cli.js",
    "vite-plus-commitlint": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build:cargo": "cargo build --release",
    "build": "cargo build --release && tsdown src/index.ts src/cli.ts --dts && mkdir -p dist/bin && cp target/release/commitlint-rs* dist/bin/ && chmod +x dist/bin/commitlint-rs*",
    "test": "vitest run",
    "check": "vp lint && vp fmt --check"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plus": "^0.1.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}
